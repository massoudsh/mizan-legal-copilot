# تنظیمات اتصال به LLM — این فایل را کپی کن به .env و مقداردهی کن
# اگر مقداردهی نشود، risk_engine در حالت fallback قاعده‌محور کار می‌کند (بدون نیاز به کلید)

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── امنیت (الزامی در production) ─────────────────────────
# development | production — در production بدون MIZAN_API_KEY و CORS_ORIGINS اپلیکیشن boot نمی‌شود
ENVIRONMENT=development

# کلید لازم برای فراخوانی POST /analyze (هدر X-API-Key). در dev اختیاری، در production الزامی.
MIZAN_API_KEY=

# origin(های) مجاز CORS، جدا با کاما (بدون wildcard). در production الزامی.
CORS_ORIGINS=http://localhost:3000

# حداکثر حجم مجاز فایل آپلودی به بایت (پیش‌فرض ۱۵ مگابایت)
MIZAN_MAX_UPLOAD_BYTES=15728640

# مسیر فایل SQLite برای پروفایل سازمان، دفتر تصمیم و پایگاه دانش مقررات
MIZAN_DATABASE_PATH=mizan.db

# OCR اسناد اسکن‌شده (نیازمند Tesseract و Poppler؛ در Docker نصب شده‌اند)
MIZAN_OCR_LANGUAGES=fas+eng
MIZAN_OCR_MAX_PAGES=20

# محدودیت نرخ /analyze
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
